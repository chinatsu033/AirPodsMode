    <string name="qs_notification_hint">Tap notification for the full SIM-style control bar. Actions: Transparency · Adaptive · Noise Cancellation.</string>
    <string name="rationale_notif_title">Notification permission</string>
    <string name="rationale_notif_body">Android requires a persistent notification for background Bluetooth connection and last-location capture when AirPods disconnect. Without it you can still switch modes while this app is open (foreground-only).</string>
    <string name="rationale_bt_title">Nearby devices / Bluetooth</string>
    <string name="rationale_bt_body">AirPods Mode needs Bluetooth permission to find your paired AirPods and open the control channel.</string>
