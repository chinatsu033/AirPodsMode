    <string name="last_location_title">Last Connected Location</string>
    <string name="last_location_explain">Apple Find My / case sound is not available without Apple’s network and reverse-engineering. Instead, when your AirPods disconnect while this app’s foreground service is running, we save GPS coordinates. Without the service, location cannot be recorded.</string>
    <string name="last_location_empty">No location saved yet. Connect AirPods with the service running, then disconnect.</string>
    <string name="last_location_open_map">Open map</string>
    <string name="last_location_clear">Clear</string>
