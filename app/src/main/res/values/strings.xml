    <string name="battery_ignored_yes">Battery optimization: unrestricted</string>
    <string name="battery_ignored_no">Battery optimization: restricted</string>
    <string name="battery_rationale">To keep Quick Settings tiles and last-location working, allow the app to ignore battery optimizations and stay in the background.</string>
    <string name="battery_request">Allow unrestricted battery</string>
    <string name="samsung_autostart_guide">Samsung One UI: Settings → Battery → Background usage limits — remove this app from sleeping/never-sleeping lists as needed; also enable Auto run (自动运行应用程序) if shown.</string>
    <string name="samsung_autostart_open">Open Samsung battery settings</string>

    <string name="findmy_not_available">Find My for AirPods cannot be implemented on Android without Apple’s network and case speakers (needs reverse engineering / root). Use Last Connected Location above instead.</string>

